{
  "manifest_version": 3,
  "name": "Activity Tracker",
  "version": "1.0.0",
  "description": "Thống kê click chuột, phím bấm và từ đã gõ – hoàn toàn cục bộ, không gửi dữ liệu đi đâu.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Activity Tracker"
  },
  "background": {
    "service_worker": "background.js"
  }
}
